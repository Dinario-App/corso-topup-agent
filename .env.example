# Copy to .env and fill in. Never commit .env.
# PayPal: SANDBOX app credentials only (developer.paypal.com > Apps & Credentials > Sandbox).
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
# Must be "sandbox". Anything else and the app refuses to start.
PAYPAL_ENVIRONMENT=sandbox

# Claude API key for the AI agent. Leave empty to use the offline rules parser (no AI).
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=

# Where PayPal sends the person back after approval. Must match how you open the app.
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Top-up limits and an optional service fee shown before approval. Default: $1-$500, no fee.
TOPUP_MIN_USD=1
TOPUP_MAX_USD=500
TOPUP_SERVICE_FEE_FLAT_USD=0
TOPUP_SERVICE_FEE_PERCENT=0
